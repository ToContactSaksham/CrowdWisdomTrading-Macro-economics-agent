# Copy to .env (or export) before running with live data.
APIFY_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Default actor is apify/web-scraper driven by the page function in
# src/macro_agent/ingestion/apify_calendar.py. Any calendar actor whose items
# contain date/time/event/actual/forecast fields can be used instead.
APIFY_ACTOR_ID=apify/web-scraper
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional overrides
RUN_DATE=2026-10-07          # pin the as-of date for reproducibility
LOOKBACK_DAYS=180
FORECAST_HORIZON_DAYS=7
TARGET=pnl                   # or win_rate
MIN_TRAIN_DAYS=60
STEP_DAYS=7
TOP_K=5
TRADING_LOG_PATH=data/raw/trading_logs.csv
OFFLINE=0                    # 1 forces the synthetic fallbacks
